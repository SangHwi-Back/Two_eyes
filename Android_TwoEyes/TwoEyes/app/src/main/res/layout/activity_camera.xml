<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_camera"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.camera.CameraActivity">

    <FrameLayout
        android:id="@+id/parent_button_back"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:backgroundTint="#18FFFF"
            app:cornerRadius="28dp" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/close_camera_screen"
            android:src="@drawable/rounded_arrow_cool_down_24"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/selected_image_layout"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/fab_margin"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/parent_button_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/image_carousel_recycler_view">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/selected_image_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            app:shapeAppearanceOverlay="@style/RoundedImageStyle"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:layout_gravity="center"
            app:tint="@color/white"
            android:src="@drawable/round_add_circle_outline_24" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/selected_image_end"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scaleType="center"
            app:shapeAppearanceOverlay="@style/RoundedImageStyle"
            app:strokeColor="@color/white"
            app:strokeWidth="2dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/image_carousel_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/selected_image_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/picture_linear_layout"/>

    <LinearLayout
        android:id="@+id/picture_linear_layout"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/button_title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-black"
            android:text="@string/add_image_description"
            android:textSize="20sp"
            app:layout_constraintBottom_toTopOf="@id/linear_layout_camera_album"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/linear_layout_camera_album"
            style="?android:attr/buttonBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/show_camera_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/design_default_color_on_secondary"
                app:cornerRadius="16dp"
                android:layout_marginEnd="8dp"
                android:drawableTop="@drawable/outline_add_reaction_24_white"
                android:text="@string/camera"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/show_album_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/design_default_color_on_secondary"
                app:cornerRadius="16dp"
                android:drawableTop="@drawable/outline_collections_bookmark_24_white"
                android:text="@string/album"/>

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>